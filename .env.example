# Variables d'environnement. Copier vers .env à la racine (jamais committé).

# Connexion Postgres Supabase, côté serveur uniquement.
# Supabase → Project Settings → Database → Connection string.
# Pour les migrations (drizzle-kit migrate), utiliser la connexion directe ou le pooler en mode session.
DATABASE_URL=

# Base locale jetable pour `pnpm test:db` (entièrement effacée à chaque exécution, localhost uniquement).
# Exemple : docker run --rm -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
